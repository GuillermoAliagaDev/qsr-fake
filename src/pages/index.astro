const products = [
  { id: 'burger', category: 'burgers', name: 'The Tremendo', eyebrow: 'THE SIGNATURE', price: '$12.90', image: '/images/burger.webp', alt: 'Double cheeseburger with lettuce and tomato', description: 'Double smashed beef, melted cheddar, crisp lettuce, tomato, pickles, and our house sauce.' },
  { id: 'fries', category: 'sides', name: 'Golden Fries', eyebrow: 'THE SIDEKICK', price: '$4.90', image: '/images/fries.webp', alt: 'Golden fries in a red carton', description: 'Hot, golden, and made for dipping. Add them to any burger.' },
  { id: 'cola', category: 'drinks', name: 'Ice Cold Cola', eyebrow: 'THE REFRESHER', price: '$3.50', image: '/images/cola.webp', alt: 'Iced cola in a takeaway cup', description: 'Fizzy cola poured over ice, the perfect finish to a big bite.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ff2b11" />
    <meta name="description" content="Tremenburguer serves big burgers, golden fries, and ice-cold drinks. See what's cooking." />
    <title>Tremenburguer — Big flavor. Good times.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div id="top" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Tremenburguer home"><span class="brand-icon" aria-hidden="true">✳</span><span>TREMEN<span class="brand-accent">BURGUER</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#about">Our story</a><a href="#menu">Menu</a><a href="#experience">The experience</a><a href="#visit">Visit</a>
      </nav>
      <a class="header-cta" href="#menu">Explore menu <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span></button>
    </header>

    <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" inert>
      <a href="#about">Our story</a><a href="#menu">Menu</a><a href="#experience">The experience</a><a href="#visit">Visit</a>
    </nav>
    <div class="menu-backdrop" aria-hidden="true"></div>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-glow"></div>
        <div class="hero-inner">
          <p class="eyebrow light"><span class="asterisk">✳</span> MADE FOR THE BIG CRAVING</p>
          <h1 id="hero-title">A NEW ERA<br />OF <em>BURGERS.</em></h1>
          <p class="hero-copy">Big flavor, good times, and the kind of bite you think about long after the last fry.</p>
          <div class="hero-actions"><a class="button button-cream" href="#menu">EXPLORE THE MENU <span aria-hidden="true">↗</span></a><a class="text-link" href="#about">Get to know us <span aria-hidden="true">↘</span></a></div>
          <div class="hero-image-wrap"><div class="hero-image-halo"></div><img class="hero-burger" src="/images/burger.webp" alt="Juicy Tremenburguer double cheeseburger" fetchpriority="high" /><span class="hero-sticker">100%<br /><small>GOOD VIBES</small></span></div>
          <div class="hero-bottom"><span>BURGERS / FRIES / GOOD TIMES</span><span>SCROLL TO DISCOVER ↓</span></div>
        </div>
      </section>

      <div class="ticker" aria-label="Fresh burgers, golden fries, ice cold drinks"><div>FRESH BURGERS <b>✳</b> GOLDEN FRIES <b>✳</b> ICE COLD DRINKS <b>✳</b> BIG FLAVOR <b>✳</b> FRESH BURGERS <b>✳</b> GOLDEN FRIES <b>✳</b></div></div>

      <section class="about section" id="about">
        <div class="section-heading"><p class="eyebrow">01 / WELCOME TO TREMENBURGUER</p><h2>Good food.<br /><span>Great company.</span></h2></div>
        <div class="about-content"><p class="lead">Some things are better together. A burger worth holding with both hands. Fries worth sharing. A cold drink to wash it all down.</p><p>We bring the good stuff together with fresh ingredients, bold flavors, and a whole lot of love. Pull up a chair. Your next favorite bite is here.</p><a class="round-link" href="#menu" aria-label="See our menu">↗</a></div>
        <div class="about-visual"><div class="about-card"><span class="small-label">THE PERFECT COMBO</span><img src="/images/fries.webp" alt="Golden French fries" loading="lazy" /><strong>MORE<br />PLEASE.</strong></div><div class="about-card orange"><span class="small-label">SERVED WITH A SMILE</span><img src="/images/cola.webp" alt="Cold cola with ice" loading="lazy" /><strong>GOOD<br />TIMES.</strong></div></div>
      </section>

      <section class="approach section" id="experience"><div class="approach-copy"><p class="eyebrow light">02 / OUR APPROACH</p><h2>ALL THE<br /><em>GOOD STUFF.</em></h2><p>It starts with a crave-worthy burger. Add a side of golden fries, a drink on ice, and the people you love eating with. That’s the Tremenburguer way.</p><a class="button button-outline" href="#menu">FIND YOUR FAVORITE <span aria-hidden="true">↗</span></a></div><div class="approach-visual"><div class="approach-ring"><span>MADE TO CRAVE · MADE TO CRAVE · </span></div><img src="/images/burger.webp" alt="Tremenburguer burger" loading="lazy" /></div></section>

      <section class="menu-section section" id="menu"><div class="menu-intro"><p class="eyebrow">03 / THE MENU</p><h2>Pick your<br /><span>happy place.</span></h2><p>Go all in on a burger, grab the perfect side, and keep things cool with a drink.</p></div>
        <div class="filters" role="group" aria-label="Filter menu"><button type="button" class="filter active" data-filter="all" aria-pressed="true">ALL GOOD STUFF</button><button type="button" class="filter" data-filter="burgers" aria-pressed="false">BURGERS</button><button type="button" class="filter" data-filter="sides" aria-pressed="false">SIDES</button><button type="button" class="filter" data-filter="drinks" aria-pressed="false">DRINKS</button></div>
        <div class="product-grid">{products.map((product) => <button class="product-card" type="button" data-category={product.category} data-id={product.id} aria-label={`View ${product.name} details`}><div class="product-photo"><img src={product.image} alt={product.alt} loading="lazy" /><span class="product-plus" aria-hidden="true">↗</span></div><div class="product-meta"><span>{product.eyebrow}</span><span>{product.price}</span></div><h3>{product.name}</h3><p>{product.description}</p></button>)}</div>
        <p class="menu-note">Menu and prices shown are sample content.</p>
      </section>

      <section class="gallery-section section"><div class="gallery-heading"><p class="eyebrow light">04 / THE CRAVING</p><h2>LOOKS GOOD.<br /><em>TASTES BETTER.</em></h2><p>Tap through the essentials that make every visit a good one.</p></div><div class="gallery-stage"><button class="gallery-arrow prev" type="button" aria-label="Previous image">←</button><div class="gallery-image"><img id="gallery-photo" src="/images/burger.webp" alt="Double cheeseburger" loading="lazy" /></div><button class="gallery-arrow next" type="button" aria-label="Next image">→</button><div class="gallery-caption"><span id="gallery-number">01 / 03</span><strong id="gallery-title">THE BIG BITE</strong></div></div><div class="gallery-thumbs" role="group" aria-label="Choose gallery image"><button type="button" class="thumb active" data-slide="0" aria-label="Show burger image" aria-pressed="true"><img src="/images/burger.webp" alt="" /></button><button type="button" class="thumb" data-slide="1" aria-label="Show fries image" aria-pressed="false"><img src="/images/fries.webp" alt="" /></button><button type="button" class="thumb" data-slide="2" aria-label="Show cola image" aria-pressed="false"><img src="/images/cola.webp" alt="" /></button></div></section>

      <section class="details section"><div><p class="eyebrow">05 / WHY WE DO IT</p><h2>Little things.<br /><span>Big feelings.</span></h2></div><div class="detail-list"><article><span>01</span><div><h3>Big on flavor</h3><p>Every layer has a reason to be there. Especially the cheese.</p></div><b>↗</b></article><article><span>02</span><div><h3>Always a good time</h3><p>Quick lunch, late craving, or a table full of friends: you belong here.</p></div><b>↗</b></article><article><span>03</span><div><h3>Made to share</h3><p>Bring your people. We’ll handle the burgers, fries, and smiles.</p></div><b>↗</b></article></div></section>

      <section class="visit section" id="visit"><div class="visit-main"><p class="eyebrow light">06 / COME HUNGRY</p><h2>LET’S EAT<br /><em>TOGETHER.</em></h2><p>Great burgers taste even better with good company. Find your favorite on the menu and make today a burger day.</p><a class="button button-cream" href="#menu">EXPLORE THE MENU <span aria-hidden="true">↗</span></a></div><img src="/images/fries.webp" alt="French fries" loading="lazy" /></section>
    </main>
    <footer><div class="footer-top"><a class="brand" href="#top"><span class="brand-icon" aria-hidden="true">✳</span><span>TREMEN<span class="brand-accent">BURGUER</span></span></a><p>BIG FLAVOR. GOOD TIMES.</p></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Tremenburguer</span><nav aria-label="Footer navigation"><a href="#about">Story</a><a href="#menu">Menu</a><a href="#experience">Experience</a><a href="#visit">Visit</a></nav><a href="#top">BACK TO TOP ↑</a></div></footer>

    <dialog id="product-dialog" aria-labelledby="dialog-title"><button class="dialog-close" type="button" aria-label="Close product details">×</button><div class="dialog-photo"><img id="dialog-image" src="" alt="" /></div><div class="dialog-copy"><p class="eyebrow" id="dialog-eyebrow"></p><h2 id="dialog-title"></h2><p id="dialog-description"></p><strong id="dialog-price"></strong></div></dialog>

    <script define:vars={{ products }}>
      const menuButton = document.querySelector('.menu-toggle');
      const mobileMenu = document.querySelector('.mobile-menu');
      const menuBackdrop = document.querySelector('.menu-backdrop');
      function setMenuOpen(open) {
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        mobileMenu.classList.toggle('open', open);
        mobileMenu.inert = !open;
        menuBackdrop.classList.toggle('open', open);
        document.body.classList.toggle('menu-open', open);
      }
      function closeMenu(returnFocus = false) { setMenuOpen(false); if (returnFocus) menuButton.focus(); }
      menuButton.addEventListener('click', () => setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true'));
      mobileMenu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      menuBackdrop.addEventListener('click', () => closeMenu(true));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') closeMenu(true); });
      window.matchMedia('(min-width: 1101px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
      document.querySelectorAll('.filter').forEach(button => button.addEventListener('click', () => { const filter = button.dataset.filter; document.querySelectorAll('.filter').forEach(item => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-pressed', String(active)); }); document.querySelectorAll('.product-card').forEach(card => { card.hidden = filter !== 'all' && card.dataset.category !== filter; }); }));
      const dialog = document.querySelector('#product-dialog');
      document.querySelectorAll('.product-card').forEach(card => card.addEventListener('click', () => { const product = products.find(item => item.id === card.dataset.id); dialog.querySelector('#dialog-image').src = product.image; dialog.querySelector('#dialog-image').alt = product.alt; dialog.querySelector('#dialog-eyebrow').textContent = product.eyebrow; dialog.querySelector('#dialog-title').textContent = product.name; dialog.querySelector('#dialog-description').textContent = product.description; dialog.querySelector('#dialog-price').textContent = product.price; dialog.showModal(); }));
      dialog.querySelector('.dialog-close').addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
      const slides = [{ image:'/images/burger.webp', alt:'Double cheeseburger', title:'THE BIG BITE' }, { image:'/images/fries.webp', alt:'Golden French fries', title:'THE PERFECT SIDE' }, { image:'/images/cola.webp', alt:'Ice cold cola', title:'THE COOL FINISH' }];
      let currentSlide = 0;
      function showSlide(index) { currentSlide = (index + slides.length) % slides.length; const slide = slides[currentSlide]; const photo = document.querySelector('#gallery-photo'); photo.src = slide.image; photo.alt = slide.alt; document.querySelector('#gallery-number').textContent = `0${currentSlide + 1} / 0${slides.length}`; document.querySelector('#gallery-title').textContent = slide.title; document.querySelectorAll('.thumb').forEach((thumb, i) => { thumb.classList.toggle('active', i === currentSlide); thumb.setAttribute('aria-pressed', String(i === currentSlide)); }); }
      document.querySelector('.gallery-arrow.prev').addEventListener('click', () => showSlide(currentSlide - 1));
      document.querySelector('.gallery-arrow.next').addEventListener('click', () => showSlide(currentSlide + 1));
      document.querySelectorAll('.thumb').forEach(button => button.addEventListener('click', () => showSlide(Number(button.dataset.slide))));
      let touchStart = 0; const gallery = document.querySelector('.gallery-stage'); gallery.addEventListener('touchstart', event => { touchStart = event.changedTouches[0].screenX; }, { passive: true }); gallery.addEventListener('touchend', event => { const delta = event.changedTouches[0].screenX - touchStart; if (Math.abs(delta) > 45) showSlide(currentSlide + (delta < 0 ? 1 : -1)); }, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root{font-family:'DM Sans',sans-serif;color:#221713;background:#fffaf0;scroll-behavior:smooth}*{box-sizing:border-box}body{margin:0;overflow-x:hidden}button,a{ -webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Outfit',sans-serif}::selection{background:#ff791d;color:#fff}.site-header{height:76px;display:flex;align-items:center;gap:38px;padding:0 clamp(24px,4vw,64px);background:#211a17;color:#fff9ec;position:relative;z-index:20}.brand{display:inline-flex;align-items:center;gap:12px;font-family:'Outfit',sans-serif;font-size:19px;font-weight:900;letter-spacing:-.045em;white-space:nowrap}.brand-icon{width:40px;height:40px;display:grid;place-items:center;border:1px solid #ae8e79;font-size:26px;font-weight:400}.brand-accent{color:#ff6932}.desktop-nav{display:flex;gap:32px;margin-left:auto;font-size:13px;font-weight:700}.desktop-nav a:hover,.footer-bottom a:hover{color:#ff832b}.header-cta{border:1px solid #77685e;padding:13px 18px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.header-cta span{margin-left:15px}.menu-toggle{display:none;width:42px;height:42px;background:none;color:white;border:1px solid #77685e;place-items:center;padding:11px}.menu-toggle span{height:1px;width:18px;background:#fff;display:block}.mobile-menu{display:none}.hero{min-height:720px;background:linear-gradient(155deg,#ff1710 6%,#ff3211 44%,#ff8818 100%);color:#fff8df;position:relative;overflow:hidden}.hero-glow{position:absolute;width:70vw;height:70vw;max-width:930px;max-height:930px;right:-15%;bottom:-80%;background:radial-gradient(circle,#ffb125 0%,transparent 64%);opacity:.8}.hero-inner{max-width:1500px;min-height:720px;margin:auto;position:relative;padding:88px clamp(24px,4vw,64px) 28px}.eyebrow{font-size:11px;font-weight:900;letter-spacing:.18em;color:#de3c16;text-transform:uppercase}.eyebrow.light{color:#fff2c3}.asterisk{font-size:22px;vertical-align:-3px;margin-right:6px}.hero h1{font-size:clamp(70px,8.8vw,150px);line-height:.82;letter-spacing:-.075em;font-weight:900;position:relative;z-index:2;margin:25px 0 28px;max-width:900px}.hero h1 em,.approach h2 em,.gallery-heading h2 em,.visit h2 em{font-style:normal;color:#ffd851}.hero-copy{max-width:420px;font-size:18px;line-height:1.6;position:relative;z-index:2}.hero-actions{display:flex;align-items:center;gap:25px;position:relative;z-index:3;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:22px;padding:19px 24px;font-size:12px;letter-spacing:.08em;font-weight:900;min-height:56px}.button span{font-size:20px;line-height:0}.button-cream{background:#fff7df;color:#251813}.button-cream:hover{background:#ffdb62}.text-link{font-size:13px;font-weight:700;border-bottom:1px solid #fff5de;padding-bottom:6px}.text-link span{margin-left:14px}.hero-image-wrap{position:absolute;width:56%;right:-1%;bottom:-9%;aspect-ratio:1;z-index:1}.hero-burger{width:100%;height:100%;object-fit:contain;position:relative;z-index:2;filter:drop-shadow(0 36px 32px #64130b77);animation:float 5s ease-in-out infinite}.hero-image-halo{position:absolute;inset:13%;border-radius:50%;border:1px solid #ffcf9666;background:#ffc15622}.hero-sticker{position:absolute;z-index:3;top:16%;right:9%;width:100px;height:100px;background:#fff2c3;color:#d22b12;border-radius:50%;display:grid;place-content:center;text-align:center;font-family:Outfit;font-weight:900;font-size:24px;line-height:1;transform:rotate(14deg);box-shadow:0 12px 26px #9b270e44}.hero-sticker small{font-size:10px;letter-spacing:.06em;margin-top:4px}.hero-bottom{position:absolute;bottom:29px;left:clamp(24px,4vw,64px);right:clamp(24px,4vw,64px);display:flex;justify-content:space-between;font-size:11px;font-weight:800;letter-spacing:.12em;z-index:3}@keyframes float{50%{transform:translateY(-12px) rotate(2deg)}}.ticker{overflow:hidden;background:#211a17;color:#fff2d0;padding:18px 0